# All optional. The site runs without any of them.
# Registration form / ticket link. Without it the "Register now" button renders disabled.
NEXT_PUBLIC_REGISTER_URL=
# Verified production origin (enables canonical URL + Open Graph base).
NEXT_PUBLIC_SITE_URL=
# e.g. https://ik.imagekit.io/your_imagekit_id  (public endpoint only, never private keys)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
